# JAYDEN — AI Website Consultant
# Get a key from https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=

# Optional — lets the MITTAL OS dashboard's Jayden read the mittal-website repo and open
# pull requests for code changes (never a direct push/deploy). Fine-grained GitHub PAT
# scoped to ONLY the Shubham-mittal-2903/Mittal-Website repo, with "Contents:
# Read and write" + "Pull requests: Read and write" permissions and nothing else.
# Without this set, Jayden still works as a normal read-only chat assistant.
GITHUB_TOKEN=

# Supabase — Postgres + Auth + Storage for the /leads CRM
# Project Settings → Database (connection strings), Settings → API (keys)
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only — used by scripts/migrate-mission-august.ts, never read by the deployed app.
MISSION_AUGUST_PATH=
