// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  SOURCED
  CONTACTED
  REPLIED
  DISCOVERY_BOOKED
  DISCOVERY_DONE
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadNoteType {
  DISCOVERY
  PSYCHOLOGY
  NEXT_ACTIONS
  PROJECT_STATUS
  PROPOSAL_NARRATIVE
  GENERAL
}

enum FindingType {
  POSITIVE
  GAP
  NOT_VERIFIED
  ISSUE
}

enum EmailDraftStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  SENT
}

enum FollowupStatus {
  SCHEDULED
  SENT
  SKIPPED
  CANCELLED
}

enum AttachmentCategory {
  SCREENSHOT
  AUDIT_REPORT
  VIDEO
  CONTRACT
  INVOICE
  NOTE
  OTHER
}

enum ClientStatus {
  ACTIVE
  PAST
  PAUSED
}

enum ProposalPackage {
  LAUNCH
  PRESENCE
  GROWTH
  SIGNATURE
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Lead {
  id             String     @id @default(cuid())
  leadNumber     Int        @unique
  legacyId       String?    @unique // e.g. "MA-001", null for app-native leads

  company        String
  industry       String?
  website        String?
  location       String?
  email          String?
  phone          String?
  decisionMaker  String?

  priority       Priority   @default(MEDIUM)
  status         LeadStatus @default(SOURCED)
  leadScore      Int?
  scoreBreakdown Json? // { gapSeverity, businessHealth, reachability, budgetSize, urgency }
  source         String?
  tags           String[]   @default([])

  notes          String?    @db.Text
  auditNotes     String?    @db.Text
  aiNotes        String?    @db.Text
  rejectedReason String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  pipelineEvents PipelineEvent[]
  leadNotes      LeadNote[]
  emailDrafts    EmailDraft[]
  emailHistory   EmailHistoryEntry[]
  followups      FollowupEntry[]
  audits         Audit[]
  attachments    Attachment[]
  proposals      Proposal[]
  client         Client?

  @@index([status])
  @@index([priority])
}

model PipelineEvent {
  id             String     @id @default(cuid())
  legacyRef      String?    @unique
  leadId         String
  lead           Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  occurredAt     DateTime
  stage          LeadStatus
  rawStageText   String? // preserves original free text when it doesn't map cleanly
  rawFields      Json? // full key/value snapshot of the source append-block, safety net
  leadScore      Int?
  scoreBreakdown Json?
  priority       Priority?
  probability    String? // e.g. "Moderate (~25-35%)" — kept as prose, source is editorial
  nextAction     String?    @db.Text
  nextActionDate DateTime?
  notes          String?    @db.Text

  createdAt      DateTime   @default(now())

  @@index([leadId, occurredAt])
}

model LeadNote {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  noteType  LeadNoteType
  body      String       @db.Text
  updatedAt DateTime     @updatedAt

  @@unique([leadId, noteType])
}

model EmailDraft {
  id                         String           @id @default(cuid())
  legacyRef                  String?          @unique
  leadId                     String
  lead                       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  version                    String // "v1", "v2", "final" — free text, source isn't uniform
  status                     EmailDraftStatus @default(DRAFT)
  subjectOptions              String[]         @default([])
  subjectFinal                String?
  previewText                 String?
  body                        String           @db.Text
  wordCount                   Int?
  confidenceScore              Int? // 0-10
  spamRisk                    String?
  bestSendTimeProspectLocal    String?
  bestSendTimeIst              String?
  followupScheduleNotes        String?          @db.Text
  portfolioLinksUsed           Json? // [{ url, why }]
  gmailDraftId                 String?

  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
}

model EmailHistoryEntry {
  id            String   @id @default(cuid())
  legacyRef     String?  @unique
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  date          DateTime
  subject       String
  emailVersion  String?
  status        String
  opened        Boolean  @default(false)
  replied       Boolean  @default(false)
  notes         String?  @db.Text
  gmailDraftId  String?

  createdAt     DateTime @default(now())
}

model FollowupEntry {
  id             String         @id @default(cuid())
  legacyRef      String?        @unique
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  followupNumber Int?
  channel        String?
  template       String?
  scheduledDate  DateTime?
  sentDate       DateTime?
  status         FollowupStatus @default(SCHEDULED)
  notes          String?        @db.Text

  createdAt      DateTime       @default(now())
}

model Audit {
  id                       String   @id @default(cuid())
  leadId                   String
  lead                     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  performedAt              DateTime
  performanceScore          Int?
  performanceScoreRaw       String? // e.g. "76-84", source gave a range not a point value
  accessibilityScore        Int?
  bestPracticesScore        Int?
  seoScore                  Int?
  powerMapperPagesFlagged    Int?
  brokenLinks                String[] @default([])
  browserIssues              String?  @db.Text
  accessibilityIssues        String?  @db.Text
  performanceObservations    String?  @db.Text
  positiveObservations       String?  @db.Text
  improvementOpportunities   String?  @db.Text
  rawNotes                   String?  @db.Text // narrative sections that don't map to a clean column
  source                     String? // "founder-provided", "live inspection", "PageSpeed API"
  verified                   Boolean  @default(false)

  createdAt                 DateTime @default(now())
  findings                  AuditFinding[]
}

model AuditFinding {
  id          String      @id @default(cuid())
  auditId     String
  audit       Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)

  type        FindingType
  category    String?
  description String      @db.Text
  createdAt   DateTime    @default(now())
}

model Attachment {
  id          String             @id @default(cuid())
  leadId      String?
  lead        Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposalId  String?
  proposal    Proposal?          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  category    AttachmentCategory
  fileName    String
  storagePath String // path within the Supabase Storage bucket
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime           @default(now())
}

model Client {
  id             String       @id @default(cuid())
  leadId         String?      @unique
  lead           Lead?        @relation(fields: [leadId], references: [id])
  name           String
  company        String?
  email          String?
  phone          String?
  billingAddress String?      @db.Text
  status         ClientStatus @default(ACTIVE)
  notes          String?      @db.Text

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  proposals      Proposal[]
  contracts      Contract[]
  invoices       Invoice[]
  attachments    Attachment[]
  projects       Project[]
  transactions   Transaction[]
}

model Proposal {
  id         String          @id @default(cuid())
  leadId     String
  lead       Lead            @relation(fields: [leadId], references: [id])
  clientId   String?
  client     Client?         @relation(fields: [clientId], references: [id])

  package    ProposalPackage
  priceMin   Decimal?        @db.Decimal(10, 2)
  priceMax   Decimal?        @db.Decimal(10, 2)
  currency   String          @default("USD")
  status     ProposalStatus  @default(DRAFT)
  content    String?         @db.Text
  sentAt     DateTime?

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  contract   Contract?
  attachments Attachment[]
}

model Contract {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  proposalId String?        @unique
  proposal   Proposal?      @relation(fields: [proposalId], references: [id])

  value      Decimal?       @db.Decimal(10, 2)
  status     ContractStatus @default(DRAFT)
  signedAt   DateTime?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  invoices   Invoice[]
  attachments Attachment[]
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      Contract?     @relation(fields: [contractId], references: [id])

  invoiceNumber String        @unique // "YYYY-MM-DD-[ClientInitials]-[seq]", built in app code
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attachments   Attachment[]
  transaction   Transaction?
}

model DailyReport {
  id                   String   @id @default(cuid())
  date                 DateTime @unique @db.Date
  isPlanOnly           Boolean  @default(false) // true for a day with only an action plan, no completed report

  whatGotDone          String?  @db.Text
  wins                 String?  @db.Text
  mistakes             String?  @db.Text
  lessonsLearned       String?  @db.Text
  tomorrowsObjectives  String?  @db.Text
  priorityTasks        String?  @db.Text
  expectedNumbers      Json?
  actualNumbers        Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AppSettings {
  id                  Int      @id @default(1) // enforced singleton, app always upserts id=1
  profileName         String   @default("Shubham Mittal")
  profileEmail        String?
  emailSignature      String?  @db.Text
  portfolioLinks      Json? // [{ url, label, useCase }]
  outreachPreferences Json?
  updatedAt           DateTime @updatedAt
}

// ============================================================
// MITTAL OS — modules beyond the Leads CRM
// ============================================================

// ---------- Shared: Projects + Planner tasks ----------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  budget      Decimal?      @db.Decimal(10, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  tags        String[]      @default([])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]

  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  recurrence  RecurrenceRule @default(NONE)
  listName    String? // free-form bucket, e.g. "Mission August" — null = general planner task
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([dueDate])
}

// ---------- Job Tracker + Resume Manager ----------

enum JobApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Resume {
  id         String   @id @default(cuid())
  name       String
  version    Int      @default(1)
  targetRole String?
  fileUrl    String? // path within Supabase Storage
  fileName   String?
  isActive   Boolean  @default(false)
  notes      String?  @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobApplications JobApplication[]
}

model JobApplication {
  id         String                @id @default(cuid())
  company    String
  role       String
  packageOffered String? // "package" is a reserved-ish word in some tooling, avoid it
  location   String?
  jdUrl      String?
  status     JobApplicationStatus  @default(SAVED)
  appliedAt  DateTime?
  resumeId   String?
  resume     Resume?               @relation(fields: [resumeId], references: [id])
  notes      String?               @db.Text

  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  checklist  JobChecklistItem[]
  rounds     InterviewRound[]

  @@index([status])
}

model JobChecklistItem {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  label            String
  done             Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

enum InterviewRoundType {
  OA
  TECHNICAL
  HR
  MANAGERIAL
  SYSTEM_DESIGN
  OTHER
}

enum InterviewRoundStatus {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
}

model InterviewRound {
  id               String               @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication       @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  type             InterviewRoundType
  scheduledAt      DateTime?
  status           InterviewRoundStatus @default(SCHEDULED)
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())
}

// ---------- Placement Preparation ----------

enum PrepTopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum TargetScope {
  DAILY
  WEEKLY
}

model PrepRoadmap {
  id             String    @id @default(cuid())
  title          String
  sourceDocument String? // filename this roadmap was extracted from
  startDate      DateTime?
  targetDate     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  milestones     PrepMilestone[]
  topics         PrepTopic[]
  targets        PrepTarget[]
}

model PrepMilestone {
  id          String      @id @default(cuid())
  roadmapId   String
  roadmap     PrepRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
}

model PrepTopic {
  id          String          @id @default(cuid())
  roadmapId   String
  roadmap     PrepRoadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title       String
  category    String? // "DSA", "Aptitude", "HR", "Technical", ...
  status      PrepTopicStatus @default(NOT_STARTED)
  isWeak      Boolean         @default(false)
  resources   Json? // [{ label, url }]
  notes       String?         @db.Text
  order       Int             @default(0)
  approvedAt  DateTime? // set only on manual approval — status changes are never auto-applied

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
}

model PrepTarget {
  id        String       @id @default(cuid())
  roadmapId String?
  roadmap   PrepRoadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  scope     TargetScope
  date      DateTime     @db.Date // DAILY: the day; WEEKLY: the Monday that starts the week
  title     String
  done      Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([scope, date])
}

// ---------- Learning ----------

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LearningTopic {
  id            String         @id @default(cuid())
  name          String         @unique
  category      String? // "Frontend", "Backend", "CS Fundamentals", "AI"
  status        LearningStatus @default(NOT_STARTED)
  completionPct Int            @default(0)
  lastRevisedAt DateTime?
  notes         String?        @db.Text

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  resources     LearningResource[]
  projects      LearningProject[]
}

model LearningResource {
  id        String        @id @default(cuid())
  topicId   String
  topic     LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  type      String? // "video", "article", "course", "docs"
  completed Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model LearningProject {
  id        String        @id @default(cuid())
  topicId   String
  topic     LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name      String
  url       String?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
}

// ---------- College + Attendance ----------

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

enum AttendanceMark {
  PRESENT
  ABSENT
  CANCELLED
}

model Subject {
  id               String   @id @default(cuid())
  name             String
  code             String?
  credits          Int?
  facultyName      String?
  totalClasses     Int      @default(0)
  attendedClasses  Int      @default(0)
  minAttendancePct Int      @default(75)
  examDate         DateTime?
  internalMarks    Decimal? @db.Decimal(5, 2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments      Assignment[]
  attendanceLog    AttendanceEntry[]
}

model Assignment {
  id        String           @id @default(cuid())
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  status    AssignmentStatus @default(PENDING)
  grade     String?
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
}

model AttendanceEntry {
  id        String         @id @default(cuid())
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  mark      AttendanceMark
  createdAt DateTime       @default(now())

  @@unique([subjectId, date])
}

// ---------- Finance ----------

enum TransactionType {
  INCOME
  EXPENSE
}

model FinanceCategory {
  id           String            @id @default(cuid())
  name         String            @unique
  type         TransactionType
  createdAt    DateTime          @default(now())

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String           @id @default(cuid())
  categoryId  String?
  category    FinanceCategory? @relation(fields: [categoryId], references: [id])
  type        TransactionType
  amount      Decimal          @db.Decimal(10, 2)
  description String?
  date        DateTime         @db.Date
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id])
  invoiceId   String?          @unique
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id])

  createdAt   DateTime         @default(now())

  @@index([date])
  @@index([type])
}

model Budget {
  id          String          @id @default(cuid())
  categoryId  String
  category    FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month       DateTime        @db.Date // first of month
  limitAmount Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())

  @@unique([categoryId, month])
}

// ---------- Knowledge Vault + Documents ----------
// One model backs both sidebar pages: Documents is VaultItem filtered to real-file types
// (PDF/DOCX/EXCEL/IMAGE/VIDEO); Knowledge Vault shows everything, including prompts/notes.

enum VaultItemType {
  PDF
  DOCX
  EXCEL
  IMAGE
  VIDEO
  RESEARCH
  CLAUDE_PROMPT
  CHATGPT_PROMPT
  MEETING_NOTES
  OTHER
}

model VaultItem {
  id        String        @id @default(cuid())
  title     String
  type      VaultItemType
  content   String?       @db.Text // full text for prompts/notes/research — searchable
  fileUrl   String? // Supabase Storage path for real files
  fileName  String?
  fileSize  Int?
  tags      String[]      @default([])

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
}
